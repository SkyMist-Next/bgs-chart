{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "database",
    "gateway",
    "services"
  ],
  "properties": {
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "webAuthUrl": {
      "type": "string",
      "pattern": "^$|^https://[^/]+/bnetserver/login/$"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,47}$"
        }
      }
    },
    "gateway": {
      "type": "object",
      "required": [
        "className",
        "hostname",
        "frontendSecret",
        "restSecret"
      ],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "frontendSecret": {
          "type": "string"
        },
        "restSecret": {
          "type": "string"
        },
        "trustedProxyCIDRs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trustedHttpProxyCIDRs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "namespaceSelector": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "podSelector": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "proxyProtocol": {
          "enum": [
            "off",
            "v2"
          ]
        }
      }
    },
    "replicas": {
      "type": "integer",
      "minimum": 1
    },
    "rabbitmq": {
      "type": "object",
      "properties": {
        "replicas": {
          "enum": [
            1,
            3,
            5,
            7
          ]
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frontend",
        "rest",
        "authentication",
        "account",
        "game_utilities"
      ],
      "properties": {
        "frontend": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "rest": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "authentication": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "account": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "game_utilities": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "certificate": {
      "type": "object",
      "required": [
        "enabled",
        "issuerRef"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string"
        },
        "issuerRef": {
          "type": "object",
          "required": [
            "name",
            "kind",
            "group"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "group": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "ipBansEnabled": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "certificate": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "gateway": {
            "properties": {
              "frontendSecret": {
                "minLength": 1
              },
              "restSecret": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
